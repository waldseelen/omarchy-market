#!/usr/bin/env bash
set -euo pipefail

url=${1:-}
target=${2:-}
[[ -n $url && -n $target ]] || exit 1

# If target already exists and is non-empty, succeed immediately
if [[ -s $target ]]; then
  exit 0
fi

mkdir -p "$(dirname "$target")"
tmp="${target}.tmp.$$"
trap 'rm -f -- "$tmp"' EXIT

http_code=$(
  curl --fail --silent --show-error \
    --proto '=https' \
    --max-time 10 \
    --max-filesize 8388608 \
    --output "$tmp" \
    --write-out '%{http_code}' \
    -- "$url" 2>/dev/null || true
)

if [[ $http_code == "200" && -s $tmp ]]; then
  mv -f -- "$tmp" "$target"
  trap - EXIT
  exit 0
fi

exit 1
